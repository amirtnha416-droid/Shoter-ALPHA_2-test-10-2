{
  "name": "alpha-x",
  "version": "1.0.0",
  "private": true,
  "description": "ALPHA-X game packaged for Windows and Android",
  "main": "electron/main.cjs",
  "scripts": {
    "prepare:game": "node scripts/prepare-game.mjs",
    "start": "npm run prepare:game && electron .",
    "build:windows": "npm run prepare:game && electron-builder --win"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/cli": "6.2.1",
    "@capacitor/core": "6.2.1",
    "@dimforge/rapier3d-compat": "0.14.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.alphax.desktop",
    "productName": "ALPHA-X",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "game/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
